# 复制为 .env 后填写本地值；.env 已被 .gitignore 忽略。
# 这里只写字段说明，不放任何可复用的口令，也不要写入真实环境凭据。

# 容器数据库的初始化参数（docker compose 使用）
POSTGRES_USER=<本地用户名>
POSTGRES_PASSWORD=<本地口令，勿复用任何真实环境口令>
POSTGRES_DB=<本地库名>
POSTGRES_PORT=5432

# 应用侧连接串（导入器不再提供默认兜底，缺失即报错）
CREDITRISK_DB_URL=postgresql+psycopg2://<user>:<password>@127.0.0.1:5432/<db>

# 实库集成测试专用连接串（仅本地或 CI 的短生命周期数据库）
CREDITRISK_TEST_DB_URL=postgresql+psycopg2://<test_user>:<test_password>@127.0.0.1:5432/<test_db>
