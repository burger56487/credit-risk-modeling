# Data (never commit raw or processed data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated reports (aggregated metrics only; never per-applicant predictions)
reports/

# Local run records and artefacts
artifacts/

# Secrets (never commit tokens or local environment files)
.env
.env.*
!.env.example

# Model artefacts and local databases
*.joblib
*.sqlite3
*.sqlite3-*

# Coverage output (reports/ already ignores the report directory)
.coverage
.coverage.*
htmlcov/

# Alternate uv environment used for lock-file verification
.venv-uv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Notebooks checkpoints
.ipynb_checkpoints/
